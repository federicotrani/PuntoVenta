@inject NavigationManager Navigation

<div class="user-menu dropdown">
    <button type="button"
            class="btn btn-link user-menu-button dropdown-toggle"
            aria-expanded="@menuAbierto"
            @onclick="AlternarMenu">
        <span class="user-avatar" aria-hidden="true">JP</span>
        <span class="user-menu-name">Juan Pérez</span>
    </button>

    @if (menuAbierto)
    {
        <div class="dropdown-menu dropdown-menu-end show user-menu-dropdown">
            <div class="dropdown-header">
                <strong>Juan Pérez</strong>
                <small class="d-block text-muted">Administrador</small>
            </div>
            <div class="dropdown-divider"></div>
            <NavLink class="dropdown-item" href="configuracion" @onclick="CerrarMenu">
                Configuración
            </NavLink>
            <button type="button" class="dropdown-item" @onclick="CerrarSesion">
                Cerrar sesión
            </button>
        </div>
    }
</div>

@code {
    private bool menuAbierto;

    private void AlternarMenu()
    {
        menuAbierto = !menuAbierto;
    }

    private void CerrarMenu()
    {
        menuAbierto = false;
    }

    private void CerrarSesion()
    {
        menuAbierto = false;
        Navigation.NavigateTo("/");
    }
}
