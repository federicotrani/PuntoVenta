@page "/categorias"
@using PuntoVenta.Client.Services
@using PuntoVenta.Shared.Entities
@inject ICategoriaService _categoriaService
@inject IJSRuntime JS
@inject NavigationManager _navigation

<h3>Lista de Categorias</h3>

<div class="text-end">
    <button class="btn btn-sm btn-success" @onclick="AgregarCategoria" disabled="@cargando">Agregar</button>
    <button class="btn btn-sm btn-warning" disabled="@(cargando || descargando)" @onclick="DescargarPdf">PDF</button>
</div>

@* Diálogo de confirmación ELIMINAR *@
@if (mostrarDialogoEliminar && categoriaSeleccionada is not null)
{
    <div class="modal-backdrop fade show" @onclick="CancelarEliminacion"></div>

    <div class="modal fade show d-block" tabindex="-1" role="dialog"
         aria-modal="true" aria-labelledby="tituloConfirmacion">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 id="tituloConfirmacion" class="modal-title">
                        Confirmar eliminación
                    </h5>
                    <button type="button" class="btn-close" aria-label="Cerrar"
                            @onclick="CancelarEliminacion"></button>
                </div>

                <div class="modal-body">
                    ¿Desea eliminar la categoría
                    <strong>@categoriaSeleccionada.Nombre</strong>?
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            @onclick="CancelarEliminacion" disabled="@eliminando">
                        Cancelar
                    </button>
                    <button type="button" class="btn btn-danger"
                            @onclick="ConfirmarEliminacion" disabled="@eliminando">
                        @(eliminando ? "Eliminando..." : "Eliminar")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (cargando)
{
    <div class="spinner-border spinner-border-sm"></div>
    <p>Procesando...</p>
}else if (categorias.Count() == 0)
{
    <p>No hay datos</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var categoria in categorias)
            {
                <tr>
                    <td>@categoria.Id</td>
                    <td>@categoria.Nombre</td>
                    <td>
                        <button class="btn btn-sm btn-primary" @onclick="() => EditarCategoria(categoria.Id)">Editar</button>
                        <button class="btn btn-sm btn-danger"
                                @onclick="() => SolicitarEliminacion(categoria)"
                                disabled="@cargando">
                            Eliminar
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}


@code {
    private List<Categoria> categorias = [];

    private bool cargando = false;
    private bool descargando = false;
    private bool eliminando = false;
    private bool mostrarDialogoEliminar = false;
    private Categoria? categoriaSeleccionada;


    protected override async Task OnInitializedAsync()
    {
        cargando = true;
        categorias = await _categoriaService.GetCategoriasAsync();
        cargando = false;
    }

    private async Task DescargarPdf()
    {
        descargando = true;

        try
        {
            var pdf = await _categoriaService.GetCategoriasPdfAsync();

            if (pdf is not null)
            {
                await JS.InvokeVoidAsync("downloadFile", "categorias.pdf", "application/pdf", pdf);
            }
        }
        finally
        {
            descargando = false;
        }
    }

    private void AgregarCategoria()
    {
        // Navigate to the category detail page for adding a new category
        _navigation.NavigateTo("/categorias/0");
    }

    private void EditarCategoria(int id)
    {
        // Navigate to the category detail page for editing the selected category
        _navigation.NavigateTo($"/categorias/{id}");
    }

    private void SolicitarEliminacion(Categoria categoria)
    {
        categoriaSeleccionada = categoria;
        mostrarDialogoEliminar = true;
    }

    private void CancelarEliminacion()
    {
        if (eliminando)
        {
            return;
        }

        mostrarDialogoEliminar = false;
        categoriaSeleccionada = null;
    }

    private async Task ConfirmarEliminacion()
    {
        if (categoriaSeleccionada is null)
        {
            return;
        }

        eliminando = true;

        try
        {
            var eliminado = await _categoriaService.DeleteCategoriaAsync(categoriaSeleccionada.Id);

            if (eliminado)
            {
                categorias.Remove(categoriaSeleccionada);
                mostrarDialogoEliminar = false;
                categoriaSeleccionada = null;
            }
        }
        finally
        {
            eliminando = false;
        }
    }
}
