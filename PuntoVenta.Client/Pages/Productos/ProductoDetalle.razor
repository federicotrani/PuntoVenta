@page "/productos/nuevo"
@page "/productos/{Id:int}"
@using PuntoVenta.Client.Services
@using PuntoVenta.Shared.DTOs
@using PuntoVenta.Shared.Entities
@using PuntoVenta.Shared
@inject IProductoService ProductoService
@inject ICategoriaService CategoriaService
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>@(Id == 0 ? "Agregar producto" : "Modificar producto")</h3>

@if (cargando)
{
    <p>Procesando...</p>
}
else if (!string.IsNullOrWhiteSpace(errorCarga))
{
    <div class="alert alert-danger">@errorCarga</div>
    <button type="button" class="btn btn-secondary" @onclick="Cancelar">Volver</button>
}
else
{
    <EditForm Model="@producto" OnValidSubmit="Guardar" class="col-12 col-md-8">
        <DataAnnotationsValidator />
        <ValidationSummary />

        @if (!string.IsNullOrWhiteSpace(errorGuardar))
        {
            <div class="alert alert-danger">@errorGuardar</div>
        }

        <div class="mb-3">
            <label for="nombre" class="form-label">Nombre</label>
            <InputText id="nombre" class="form-control" @bind-Value="producto.Nombre" />
            <ValidationMessage For="@(() => producto.Nombre)" />
        </div>

        <div class="mb-3">
            <label for="precio" class="form-label">Precio</label>
            <InputNumber id="precio" class="form-control" @bind-Value="producto.Precio" />
            <ValidationMessage For="@(() => producto.Precio)" />
        </div>

        <div class="mb-3">
            <label for="categoria" class="form-label">Categoría</label>
            <InputSelect id="categoria" class="form-select" @bind-Value="producto.CategoriaId">
                <option value="0">Seleccione una categoría</option>
                @foreach (var categoria in categorias)
                {
                    <option value="@categoria.Id">@categoria.Nombre</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => producto.CategoriaId)" />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label for="stockActual" class="form-label">Stock actual</label>
                <InputNumber id="stockActual" class="form-control" @bind-Value="producto.StockActual" />
                <ValidationMessage For="@(() => producto.StockActual)" />
            </div>
            <div class="col-md-6 mb-3">
                <label for="stockMinimo" class="form-label">Stock mínimo</label>
                <InputNumber id="stockMinimo" class="form-control" @bind-Value="producto.StockMinimo" />
                <ValidationMessage For="@(() => producto.StockMinimo)" />
            </div>
        </div>

        <div class="mb-3">
            <label for="imagen" class="form-label">Imagen (PNG o JPG, máximo 5 MB)</label>
            <InputFile id="imagen" class="form-control" accept=".png,.jpg,.jpeg" OnChange="SeleccionarImagen" />
            @if (!string.IsNullOrWhiteSpace(errorImagen))
            {
                <div class="text-danger small mt-1">@errorImagen</div>
            }
            @if (UrlVistaPrevia is not null)
            {
                <img src="@UrlVistaPrevia" alt="Imagen del producto" class="img-thumbnail mt-2" style="max-width: 240px; max-height: 240px;" />
            }
        </div>

        <div class="form-check mb-3">
            <InputCheckbox id="activo" class="form-check-input" @bind-Value="producto.Activo" />
            <label for="activo" class="form-check-label">Activo</label>
        </div>

        <button type="submit" class="btn btn-primary" disabled="@guardando">
            @(guardando ? "Guardando..." : "Guardar")
        </button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="Cancelar" disabled="@guardando">Cancelar</button>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private ProductoFormDto producto = new();
    private List<Categoria> categorias = [];
    private bool cargando = true;
    private bool guardando;
    private string? errorCarga;
    private string? errorGuardar;
    private string? errorImagen;
    private ImagenUploadDto? imagenSeleccionada;
    private string? vistaPreviaNueva;

    private string? UrlVistaPrevia => vistaPreviaNueva
        ?? (string.IsNullOrWhiteSpace(producto.UrlImagen)
            ? null
            : new Uri(Http.BaseAddress!, $"{ImagenProductoReglas.CarpetaUpload}/{producto.UrlImagen}").ToString());

    protected override async Task OnInitializedAsync()
    {
        categorias = await CategoriaService.GetCategoriasAsync() ?? [];

        if (categorias.Count == 0)
        {
            errorCarga = "No hay categorías disponibles. Cree una categoría antes de agregar o modificar un producto.";
        }
        else if (Id > 0)
        {
            var productoExistente = await ProductoService.GetProductoByIdAsync(Id);

            if (productoExistente is null)
            {
                errorCarga = "No se encontró el producto solicitado.";
            }
            else
            {
                producto = new ProductoFormDto
                {
                    Nombre = productoExistente.Nombre,
                    Precio = productoExistente.Precio,
                    CategoriaId = productoExistente.CategoriaId,
                    StockActual = productoExistente.StockActual,
                    StockMinimo = productoExistente.StockMinimo,
                    UrlImagen = productoExistente.UrlImagen ?? string.Empty,
                    Activo = productoExistente.Activo
                };
            }
        }

        cargando = false;
    }

    private async Task Guardar()
    {
        guardando = true;
        errorGuardar = null;

        var dto = producto.ToAgregarDto();

        var guardado = Id == 0
            ? await ProductoService.AddProductoAsync(dto, imagenSeleccionada)
            : await ProductoService.UpdateProductoAsync(Id, dto, imagenSeleccionada);

        if (guardado)
        {
            Navigation.NavigateTo("/productos");
            return;
        }

        errorGuardar = "No se pudo guardar el producto. Compruebe los datos e inténtelo de nuevo.";
        guardando = false;
    }

    private async Task SeleccionarImagen(InputFileChangeEventArgs e)
    {
        errorImagen = null;
        imagenSeleccionada = null;
        vistaPreviaNueva = null;

        var archivo = e.File;
        var extension = Path.GetExtension(archivo.Name).ToLowerInvariant();

        if (!ImagenProductoReglas.ExtensionesPermitidas.Contains(extension)
            || !ImagenProductoReglas.ContentTypesPermitidos.Contains(archivo.ContentType.ToLowerInvariant()))
        {
            errorImagen = "Solo se permiten archivos PNG o JPG.";
            return;
        }

        if (archivo.Size > ImagenProductoReglas.TamanoMaximoBytes)
        {
            errorImagen = "La imagen no puede superar los 5 MB.";
            return;
        }

        try
        {
            using var stream = archivo.OpenReadStream(ImagenProductoReglas.TamanoMaximoBytes);
            using var memoria = new MemoryStream();
            await stream.CopyToAsync(memoria);
            var contenido = memoria.ToArray();

            imagenSeleccionada = new ImagenUploadDto(archivo.Name, archivo.ContentType, contenido);
            vistaPreviaNueva = $"data:{archivo.ContentType};base64,{Convert.ToBase64String(contenido)}";
        }
        catch (IOException)
        {
            errorImagen = "No se pudo leer la imagen seleccionada.";
        }
    }

    private void Cancelar()
    {
        Navigation.NavigateTo("/productos");
    }
}
